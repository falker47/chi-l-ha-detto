{
  "name": "chi-l-ha-detto",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "validate": "tsx scripts/validate.ts",
    "deploy": "npm run build && echo 'Build completata! Ora committa e pusha su GitHub.'",
    "server": "tsx --env-file-if-exists=.env.local scripts/dev-api.ts",
    "dev:full": "concurrently \"npm run dev\" \"npm run server\"",
    "test": "tsx --test tests/*.test.ts",
    "lint": "eslint src api backend shared scripts tests vite.config.ts",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate-leaderboard.ts",
    "db:import": "tsx --env-file-if-exists=.env.local scripts/import-leaderboard.ts",
    "db:export-supabase": "tsx --env-file-if-exists=.env.local scripts/export-supabase.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.leaderboard.json"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@eslint/js": "9.39.5",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.0.2",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "csv-parse": "7.0.2",
    "eslint": "9.39.5",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "tsx": "^4.7.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "8.70.0",
    "vite": "^5.4.0"
  },
  "engines": {
    "node": "22.x"
  }
}
